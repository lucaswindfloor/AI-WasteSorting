<mujoco model="Single PET bottle pick">
  <compiler angle="radian"/>
  <option timestep="0.001" integrator="implicitfast" iterations="50"/>
  <visual>
    <global azimuth="125" elevation="-27"/>
    <headlight ambient=".35 .35 .35" diffuse=".75 .75 .75"/>
  </visual>
  <asset>
    <texture name="belt_texture" type="2d" builtin="checker" width="512" height="64"
             rgb1=".18 .22 .25" rgb2=".23 .27 .3"/>
    <material name="belt_material" texture="belt_texture" texrepeat="48 4"/>
  </asset>
  <default>
    <geom friction=".65 .01 .001" solref=".008 1"/>
    <default class="visual">
      <geom contype="0" conaffinity="0" mass="0"/>
    </default>
    <default class="wall">
      <geom type="box" rgba=".73 .52 .25 .85"/>
    </default>
  </default>
  <worldbody>
    <light pos="1.6 -.5 3" dir=".2 .1 -1"/>
    <geom type="plane" pos="0 0 -.23" size="20 10 .1" rgba=".13 .16 .2 1"/>
    <!-- The thin collision slab translates along X. Its extra length keeps both
         ends outside the 0..5.5 m workspace throughout the pick cycle. -->
    <body name="belt">
      <joint name="belt_x" type="slide" axis="1 0 0"/>
      <geom name="belt_surface" type="box" pos="1.15 .4 -.012" size="4.5 .4 .012"
            mass="12" rgba=".2 .25 .30 0"/>
      <geom class="visual" type="box" pos="1.15 .4 -.010" size="4.5 .4 .009"
            material="belt_material"/>
    </body>
    <geom class="visual" type="box" pos="2.75 -.018 -.042" size="2.75 .018 .038" rgba=".39 .47 .55 1"/>
    <geom class="visual" type="box" pos="2.75 .818 -.042" size="2.75 .018 .038" rgba=".39 .47 .55 1"/>
    <geom class="visual" type="box" pos=".75 .40 .001" size=".003 .4 .001" rgba=".2 .85 .9 .75"/>
    <geom class="visual" type="box" pos="2.65 .79 .001" size=".25 .008 .001" rgba=".31 .85 .54 1"/>

    <body name="bottle" pos=".25 .335 .033">
      <freejoint name="bottle_free"/>
      <geom name="bottle_body" type="capsule" fromto="-.072 0 0 .047 0 0" size=".033"
            mass=".023" rgba=".53 .87 .90 1"/>
      <geom name="bottle_neck" type="capsule" fromto=".065 0 0 .09 0 0" size=".0145"
            mass=".003" rgba=".25 .68 .80 1"/>
      <geom name="bottle_cap" type="capsule" fromto=".092 0 0 .0925 0 0" size=".0125"
            mass=".002" rgba=".17 .39 .94 1"/>
    </body>

    <geom class="visual" type="box" pos="2.30 -.04 .225" size=".018 .026 .27" rgba=".45 .56 .65 1"/>
    <geom class="visual" type="box" pos="2.98 -.04 .225" size=".018 .026 .27" rgba=".45 .56 .65 1"/>
    <geom class="visual" type="box" pos="2.64 -.04 .49" size=".36 .033 .022" rgba=".45 .56 .65 1"/>
    <body name="gantry_x">
      <joint name="gantry_x" type="slide" axis="1 0 0" range="2.30 2.98"/>
      <inertial pos="0 0 .49" mass="2" diaginertia=".02 .02 .02"/>
      <geom class="visual" type="box" pos="0 .53 .49" size=".025 .605 .022" rgba=".47 .57 .65 1"/>
      <body name="gantry_y">
        <joint name="gantry_y" type="slide" axis="0 1 0" range=".11 1.10"/>
        <inertial pos="0 0 .46" mass="1" diaginertia=".006 .006 .006"/>
        <geom class="visual" type="box" pos="0 0 .46" size=".04 .034 .039" rgba=".76 .50 .21 1"/>
        <body name="cup" gravcomp="1">
          <joint name="gantry_z" type="slide" axis="0 0 1" range=".04 .33"/>
          <geom class="visual" type="cylinder" size=".009 .21" pos="0 0 .217" rgba=".65 .72 .76 1"/>
          <geom name="cup_face" type="cylinder" size=".008 .004" pos="0 0 .004" mass=".32"
                rgba=".99 .73 .23 1"/>
          <site name="cup_tip" size=".002" rgba="0 0 0 0"/>
        </body>
      </body>
    </body>

    <geom name="bin_floor" class="wall" pos="2.65 .97 -.06" size=".185 .123 .01"/>
    <geom name="bin_end_wall" class="wall" pos="2.465 .97 .012" size=".008 .123 .072"/>
    <geom class="wall" pos="2.835 .97 .012" size=".008 .123 .072"/>
    <geom class="wall" pos="2.65 .847 .012" size=".185 .008 .072"/>
    <geom class="wall" pos="2.65 1.093 .012" size=".185 .008 .072"/>
    <camera name="station" pos="3.4 1.9 1.3" xyaxes="-.87 .49 0 -.297 -.528 .795" fovy="47"/>
  </worldbody>
  <equality>
    <weld name="suction" body1="cup" body2="bottle" active="false" solref=".008 1"/>
  </equality>
  <actuator>
    <velocity name="belt_motor" joint="belt_x" kv="1800" forcerange="-300 300"/>
    <velocity name="x_motor" joint="gantry_x" kv="400" forcerange="-120 120"/>
    <velocity name="y_motor" joint="gantry_y" kv="240" forcerange="-65 65"/>
    <velocity name="z_motor" joint="gantry_z" kv="120" forcerange="-30 30"/>
  </actuator>
</mujoco>
